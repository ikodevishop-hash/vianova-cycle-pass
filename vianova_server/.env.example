# Vianova Cycle Pass API server — environment template.
# Copy to `.env` (or set these in your host) and adjust as needed.

PORT=4080
# Absolute base URL used in confirmation/reset email links.
# For LAN device testing set your PC's IP, e.g. http://192.168.0.2:4080
PUBLIC_URL=http://localhost:4080

# Admin login password (seeded on first run only).
ADMIN_PASSWORD=master123

# ── Mail delivery ────────────────────────────────────────────────
# Priority: SMTP_HOST set -> real SMTP. Else MAIL_MODE=ethereal -> test inbox.
# Else (both empty) -> mock mode (nothing sent; link logged & returned in API).
#
# MAIL_MODE=ethereal  → sends to a throwaway Ethereal inbox and prints a
#                       "preview" URL in the server log so you can read the mail
#                       in a browser. Great for end-to-end testing without a
#                       real account. (Requires outbound access to ethereal.email.)
MAIL_MODE=

# Real SMTP — fill these to actually deliver mail. SMTP_HOST being set wins over MAIL_MODE.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false        # true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vianova Cycle Pass <no-reply@vianova.example>

# ── Provider examples (copy into the SMTP_* block above) ─────────
# Gmail (use an App Password, not your login password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=Vianova Cycle Pass <youraddress@gmail.com>
#
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxx
#
# Amazon SES (ap-northeast-1):
#   SMTP_HOST=email-smtp.ap-northeast-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=your-ses-smtp-user
#   SMTP_PASS=your-ses-smtp-pass

# ── GMO PG マルチペイメント / リンクタイプPlus (card payment) ──────
# When GMO_SHOP_ID + GMO_SHOP_PASS are set, the app uses REAL GMO payment:
# the customer enters the card only on GMO's hosted page (3-D Secure 2.0
# included). Leave them empty to keep the built-in mock (demo works offline).
# The card number never reaches this server.
#
# Test env host: pt01.mul-pay.jp   /   Production host: p01.mul-pay.jp
# ShopID/ShopPass come from the GMO test-account email + ショップ管理画面.
# NEVER commit real values — set them in the host (Render → Environment).
GMO_SHOP_ID=
GMO_SHOP_PASS=
# 設定ID (16 chars) created in the GMO console. Defines the payment-screen
# design and (recommended) the 結果通知URL. Optional but recommended.
GMO_CONFIG_ID=
# AUTH (仮売上) or CAPTURE (即時売上). Default CAPTURE = charge immediately.
GMO_JOBCD=CAPTURE
# Set to true ONLY for the production GMO contract (switches to p01.mul-pay.jp).
GMO_PROD=false
# Optional: override the API host entirely (else derived from GMO_PROD).
# GMO_API_HOST=pt01.mul-pay.jp
#
# In the GMO console (設定ID), point these at THIS server:
#   結果通知URL : https://<your-server>/api/payments/notify
#   戻り先URL   : https://<your-server>/api/payments/return
# For the Render demo that is:
#   https://vianova-demo.onrender.com/api/payments/notify
#   https://vianova-demo.onrender.com/api/payments/return
