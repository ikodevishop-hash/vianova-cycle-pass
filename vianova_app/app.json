{
  "expo": {
    "name": "Vianova Cycle Pass",
    "slug": "vianova-cycle-pass",
    "owner": "ikodevis-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vianovacyclepass",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#15B981",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vianova.cyclepass",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.vianova.cyclepass",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBFCFC"
      },
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4EE"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "appKind": "user",
      "apiUrl": "https://vianova-demo.onrender.com",
      "router": {},
      "eas": {
        "projectId": "ac9ae553-6308-4b08-8486-259768851ca3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ac9ae553-6308-4b08-8486-259768851ca3"
    }
  }
}
